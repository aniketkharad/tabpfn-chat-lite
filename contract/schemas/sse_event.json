{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tabpfn-chat-lite.internal/schemas/sse_event.json",
  "title": "SSEEvent",
  "description": "Server-Sent Event frame emitted during GET /api/runs/{id}/events execution streaming. Each frame includes an incremental id for Last-Event-ID resumption.",
  "oneOf": [
    {
      "title": "QueuedEvent",
      "type": "object",
      "required": ["id", "event", "data"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "event": { "type": "string", "const": "queued" },
        "data": {
          "type": "object",
          "required": ["position", "eta_s"],
          "additionalProperties": false,
          "properties": {
            "position": { "type": "integer", "minimum": 1 },
            "eta_s": { "type": "number", "minimum": 0.0 }
          }
        }
      }
    },
    {
      "title": "StatusEvent",
      "type": "object",
      "required": ["id", "event", "data"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "event": { "type": "string", "const": "status" },
        "data": {
          "type": "object",
          "required": ["stage"],
          "additionalProperties": false,
          "properties": {
            "stage": {
              "type": "string",
              "enum": ["planning", "estimating", "fitting", "narrating"]
            },
            "message": { "type": "string" }
          }
        }
      }
    },
    {
      "title": "BlockEvent",
      "type": "object",
      "required": ["id", "event", "data"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "event": { "type": "string", "const": "block" },
        "data": {
          "type": "object",
          "required": ["block"],
          "additionalProperties": false,
          "properties": {
            "block": {
              "$ref": "result_block.json"
            }
          }
        }
      }
    },
    {
      "title": "DoneEvent",
      "type": "object",
      "required": ["id", "event", "data"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "event": { "type": "string", "const": "done" },
        "data": {
          "type": "object",
          "required": ["summary"],
          "additionalProperties": false,
          "properties": {
            "summary": { "type": "string" },
            "run_id": { "type": "string" },
            "completed_at": { "type": "string" }
          }
        }
      }
    },
    {
      "title": "ErrorEvent",
      "type": "object",
      "required": ["id", "event", "data"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "event": { "type": "string", "const": "error" },
        "data": {
          "type": "object",
          "required": ["error"],
          "additionalProperties": false,
          "properties": {
            "error": {
              "type": "object",
              "required": ["code", "message", "request_id"],
              "additionalProperties": false,
              "properties": {
                "code": {
                  "type": "string",
                  "enum": [
                    "validation",
                    "unsupported",
                    "pii_detected",
                    "rate_limited",
                    "queue_full",
                    "quota_gemini",
                    "quota_tabpfn",
                    "capacity_exhausted",
                    "kill_switch",
                    "turn_limit",
                    "backend_waking",
                    "upstream_unavailable",
                    "internal"
                  ]
                },
                "message": { "type": "string" },
                "retry_after_s": { "type": "integer" },
                "request_id": { "type": "string" }
              }
            }
          }
        }
      }
    }
  ]
}
